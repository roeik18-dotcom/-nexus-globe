<!DOCTYPE html>
<html lang="he">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Merlin — Operator Console</title>
<style>
  :root{
    --bg:#0d1117; --panel:#161b22; --panel2:#1c2230; --line:#283040; --txt:#e6edf3; --dim:#8b98a9;
    --green:#3fb950; --blue:#58a6ff; --amber:#d29922; --red:#f85149; --gray:#6b7280;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--txt);font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
  a{color:var(--blue)}
  .c-green{color:var(--green)} .c-blue{color:var(--blue)} .c-amber{color:var(--amber)} .c-red{color:var(--red)} .c-gray{color:var(--gray)}
  .bg-green{background:var(--green)} .bg-blue{background:var(--blue)} .bg-amber{background:var(--amber)} .bg-red{background:var(--red)} .bg-gray{background:var(--gray)}

  /* TOP BAR */
  #topbar{position:sticky;top:0;z-index:20;display:flex;flex-wrap:wrap;gap:14px;align-items:center;
    padding:8px 14px;background:#0a0e14;border-bottom:1px solid var(--line)}
  #topbar .brand{font-weight:700;letter-spacing:.5px;font-size:15px}
  .tb{display:flex;flex-direction:column;line-height:1.15}
  .tb .k{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px}
  .tb .v{font-size:12px;font-weight:600}
  .dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle}
  #tbUpdate{margin-left:auto;font-size:10px;color:var(--dim)}

  .wrap{max-width:1500px;margin:0 auto;padding:14px;display:grid;gap:14px;
    grid-template-columns:repeat(12,1fr)}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px;min-width:0}
  .card h2{margin:0 0 10px;font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--dim);font-weight:700}
  .span12{grid-column:span 12}.span8{grid-column:span 8}.span6{grid-column:span 6}.span4{grid-column:span 4}.span3{grid-column:span 3}
  @media(max-width:1000px){.span8,.span6,.span4,.span3{grid-column:span 12}}

  /* MAIN STATE */
  #mainState{display:flex;align-items:center;gap:20px}
  #stateOrb{width:120px;height:120px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    flex-direction:column;border:4px solid var(--gray);flex:0 0 auto}
  #stateOrb .big{font-size:19px;font-weight:800;letter-spacing:.5px}
  #stateOrb .sub{font-size:10px;color:var(--dim)}
  .orb-blue{border-color:var(--blue)!important;box-shadow:0 0 26px rgba(88,166,255,.35);animation:pulse 1.7s ease-in-out infinite}
  .orb-green{border-color:var(--green)!important;box-shadow:0 0 22px rgba(63,185,80,.3)}
  .orb-amber{border-color:var(--amber)!important;box-shadow:0 0 24px rgba(210,153,34,.35)}
  .orb-red{border-color:var(--red)!important;box-shadow:0 0 24px rgba(248,81,73,.4)}
  .orb-gray{border-color:var(--gray)!important}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.72}}
  #mainMeta{flex:1;min-width:0}
  .kv{display:grid;grid-template-columns:150px 1fr;gap:3px 10px;font-size:12px}
  .kv .k{color:var(--dim)} .kv .v{font-weight:600;word-break:break-word}
  .transcript{background:#0a0e14;border:1px solid var(--line);border-radius:6px;padding:6px 8px;margin-top:4px;
    max-height:70px;overflow:auto;font-size:12px;direction:rtl}
  .na{color:var(--gray);font-style:italic}

  .pill{display:inline-block;padding:1px 7px;border-radius:10px;font-size:10px;font-weight:700;letter-spacing:.3px}
  .pill.green{background:rgba(63,185,80,.15);color:var(--green)} .pill.blue{background:rgba(88,166,255,.15);color:var(--blue)}
  .pill.amber{background:rgba(210,153,34,.15);color:var(--amber)} .pill.red{background:rgba(248,81,73,.15);color:var(--red)}
  .pill.gray{background:rgba(107,114,128,.15);color:var(--gray)}

  /* DOMAIN */
  .domgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  @media(max-width:1000px){.domgrid{grid-template-columns:repeat(2,1fr)}}
  .dom{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px}
  .dom.sel{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue) inset}
  .dom .name{font-weight:700;font-size:12px}
  .dom .m{font-size:10px;color:var(--dim);margin-top:3px}

  /* progress */
  .bar{height:8px;background:#0a0e14;border-radius:5px;overflow:hidden;margin:6px 0}
  .bar > i{display:block;height:100%}

  /* controls */
  .ctlgrp{margin-bottom:8px}
  .ctlgrp .lbl{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px}
  button{background:var(--panel2);color:var(--txt);border:1px solid var(--line);border-radius:7px;padding:6px 10px;
    font-size:12px;cursor:pointer;margin:2px 2px 0 0}
  button:hover:not(:disabled){border-color:var(--blue)}
  button:disabled{opacity:.35;cursor:not-allowed}
  button.danger{border-color:#5a2020;color:#ff9b93} button.danger:hover:not(:disabled){border-color:var(--red)}
  button.primary{border-color:#1f6feb;background:#132a4a}
  input[type=text]{background:#0a0e14;border:1px solid var(--line);color:var(--txt);border-radius:6px;padding:6px 8px;flex:1}
  select{background:#0a0e14;border:1px solid var(--line);color:var(--txt);border-radius:6px;padding:5px}

  table{width:100%;border-collapse:collapse;font-size:11px}
  td,th{padding:3px 6px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
  th{color:var(--dim);font-weight:600;text-transform:uppercase;font-size:9px}
  .tl{max-height:230px;overflow:auto}
  .warnbar{background:rgba(210,153,34,.12);border:1px solid #4a3b12;border-radius:8px;padding:8px 12px;
    color:#e8c06a;font-weight:600;font-size:12px}
</style>
</head>
<body>

<div id="topbar">
  <span class="brand">◆ MERLIN</span>
  <div class="tb"><span class="k">Service</span><span class="v" id="tbService">—</span></div>
  <div class="tb"><span class="k">PID</span><span class="v" id="tbPid">—</span></div>
  <div class="tb"><span class="k">Port</span><span class="v">127.0.0.1:8802</span></div>
  <div class="tb"><span class="k">Runtime</span><span class="v" id="tbRuntime">—</span></div>
  <div class="tb"><span class="k">Listening</span><span class="v" id="tbListen">—</span></div>
  <div class="tb"><span class="k">Playback</span><span class="v" id="tbPlay">—</span></div>
  <div class="tb"><span class="k">In-mute</span><span class="v" id="tbInMute">—</span></div>
  <div class="tb"><span class="k">Out-mute</span><span class="v" id="tbOutMute">—</span></div>
  <div class="tb"><span class="k">Turn</span><span class="v" id="tbTurn">—</span></div>
  <div class="tb"><span class="k">Day Opening</span><span class="v" id="tbDO">—</span></div>
  <div class="tb"><span class="k">WebSocket</span><span class="v" id="tbWs">—</span></div>
  <span id="tbUpdate">connecting…</span>
</div>

<div class="wrap">

  <!-- config incompleteness operational warning (backend-driven) -->
  <div class="span12" id="covWarnWrap" style="display:none"><div class="warnbar" id="covWarn"></div></div>

  <!-- 1. MAIN STATE -->
  <div class="card span8">
    <h2>Merlin — Now</h2>
    <div id="mainState">
      <div id="stateOrb" class="orb-gray"><span class="big" id="orbState">—</span><span class="sub" id="orbSub"></span></div>
      <div id="mainMeta">
        <div class="kv">
          <div class="k">Turn ID</div><div class="v" id="msTurn">—</div>
          <div class="k">Playback active</div><div class="v" id="msPlay">—</div>
          <div class="k">Uptime</div><div class="v" id="msUptime">—</div>
          <div class="k">STT model</div><div class="v" id="msStt">—</div>
        </div>
        <div class="k" style="color:var(--dim);margin-top:6px">Last user transcript</div>
        <div class="transcript" id="msTranscript"><span class="na">—</span></div>
        <div class="k" style="color:var(--dim);margin-top:4px">Current assistant response</div>
        <div class="transcript" id="msResponse"><span class="na">—</span></div>
      </div>
    </div>
  </div>

  <!-- 2. CONTROLS (high priority: stop/mute) -->
  <div class="card span4">
    <h2>Controls</h2>
    <div id="controls"></div>
    <div style="display:flex;gap:6px;margin-top:6px">
      <input type="text" id="sendText" placeholder="Send exactly what Merlin should hear…"
             onkeydown="if(event.key==='Enter')sendAsUser()">
      <button class="primary" onclick="sendAsUser()">Send</button>
    </div>
    <div id="ctlNote" style="font-size:10px;color:var(--dim);margin-top:4px;min-height:12px"></div>
  </div>

  <!-- 3. LIVE TURN -->
  <div class="card span6">
    <h2>Live Turn</h2>
    <div class="kv" id="turnKv"></div>
  </div>

  <!-- 4. DAY OPENING -->
  <div class="card span6">
    <h2>Day Opening</h2>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
      <span class="pill gray" id="doPill">—</span>
      <button class="primary" id="doStart" onclick="startDayOpening()">▶ Start Day Opening</button>
      <label style="font-size:11px;color:var(--dim)"><input type="checkbox" id="doClap" onchange="toggleClap()"> double-clap</label>
    </div>
    <div class="bar"><i id="doBar" class="bg-gray" style="width:0%"></i></div>
    <div class="kv" id="doKv"></div>
  </div>

  <!-- 5. DOMAIN + COVERAGE -->
  <div class="card span8">
    <h2>Domains & Config Coverage</h2>
    <div class="domgrid" id="domGrid"></div>
  </div>

  <!-- 6. AUDIO / BARGE HEALTH -->
  <div class="card span4">
    <h2>Audio & Barge Health</h2>
    <div class="kv" id="audioKv"></div>
  </div>

  <!-- 7. ERROR SURFACE -->
  <div class="card span5">
    <h2>Errors / Degraded</h2>
    <div id="errSurface"><span class="na">none recent</span></div>
  </div>

  <!-- 8. EVENT TIMELINE -->
  <div class="card span7">
    <h2>Event Timeline <span style="font-weight:400;text-transform:none;color:var(--dim)">(operational events; debug spam filtered)</span></h2>
    <div class="tl"><table><thead><tr><th>Time</th><th>Turn</th><th>Source</th><th>Event</th><th>Result</th></tr></thead>
      <tbody id="tlBody"></tbody></table></div>
  </div>

  <div class="span12" style="text-align:center;color:var(--dim);font-size:10px;padding:4px">
    Live via REST polling (1.5s) — not WebSocket. Every value above is fetched from the running backend.
  </div>
</div>

<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let LAST={};                 // last full snapshot, for control-safety derivations

function col(kind){return{green:'c-green',blue:'c-blue',amber:'c-amber',red:'c-red',gray:'c-gray'}[kind]||'c-gray';}
function runtimeColor(s){return{IDLE:'gray',LISTENING:'blue',CAPTURING:'blue',TRANSCRIBING:'blue',THINKING:'blue',
  SPEAKING:'blue',INTERRUPTING:'amber',INTERRUPTED:'amber',ERROR:'red'}[s]||'gray';}
function doColor(s){return{IDLE:'gray',COLLECTING:'blue',PLAYING:'blue',COMPLETED:'green',INTERRUPTED:'amber',
  ABORTED_BY_RESTART:'amber',ERROR:'red'}[s]||'gray';}
function covColor(s){return{COMPLETE:'green',PARTIAL:'amber',MISSING:'red',UNMAPPED:'amber',UNKNOWN:'gray'}[s]||'gray';}
function pill(txt,kind){return `<span class="pill ${kind}">${esc(txt)}</span>`;}
function dot(kind){return `<span class="dot bg-${kind}"></span>`;}
function boolPill(v,onTxt,offTxt,onKind='amber',offKind='gray'){return v?pill(onTxt,onKind):pill(offTxt,offKind);}
function na(){return '<span class="na">NOT EXPOSED</span>';}

async function getJSON(u){try{const r=await fetch(u);if(!r.ok)return null;return await r.json();}catch(e){return null;}}

async function refresh(){
  const [st,turn,cov,doStat,audio,ev]=await Promise.all([
    getJSON('/api/status'),getJSON('/api/turn'),getJSON('/api/config_coverage'),
    getJSON('/api/day_opening/status'),getJSON('/api/audio'),getJSON('/api/events?n=120')
  ]);
  const now=new Date().toLocaleTimeString();
  if(!st){$('tbUpdate').innerHTML=`${dot('red')}CONNECTION STALE — no backend response (${now})`;return;}
  LAST={st,turn,cov,doStat,audio};
  $('tbUpdate').innerHTML=`${dot('green')}updated ${now}`;

  // ---- TOP BAR ----
  const online=!!st.service_running, rc=runtimeColor(st.runtime_state);
  $('tbService').innerHTML=online?`${dot('green')}ONLINE`:`${dot('red')}OFFLINE`;
  $('tbPid').innerHTML=(st.service_pid_count>1?`${dot('red')}`:'')+esc(st.service_pid ?? '—')+(st.service_pid_count>1?` (×${st.service_pid_count}!)`:'');
  $('tbRuntime').innerHTML=`${dot(rc)}${esc(st.runtime_state||'UNKNOWN')}`;
  $('tbListen').innerHTML=st.capture_active?`${dot('blue')}YES`:`${dot('gray')}no`;
  $('tbPlay').innerHTML=st.playback_active?`${dot('blue')}YES`:`${dot('gray')}no`;
  $('tbInMute').innerHTML=st.input_muted?`${dot('amber')}MUTED`:`${dot('gray')}open`;
  $('tbOutMute').innerHTML=st.muted?`${dot('amber')}MUTED`:`${dot('gray')}open`;
  $('tbTurn').textContent=st.active_turn_id ?? '—';
  $('tbDO').innerHTML=`${dot(doColor(st.day_opening_state))}${esc(st.day_opening_state||'IDLE')}`;
  // /ws/status exists in the backend but this UI intentionally uses bounded REST
  // polling (honest — not claiming realtime we don't consume).
  $('tbWs').innerHTML=`${dot('amber')}REST poll <span style="font-size:9px;color:var(--gray)">(ws avail, unused)</span>`;

  // ---- MAIN STATE ----
  const orb=$('stateOrb');orb.className='orb-'+rc;
  $('orbState').textContent=st.runtime_state||'UNKNOWN';
  $('orbSub').textContent=st.muted?'OUTPUT MUTED':(st.input_muted?'INPUT MUTED':'');
  $('msTurn').textContent=st.active_turn_id ?? '—';
  $('msPlay').innerHTML=st.playback_active?pill('ACTIVE','blue'):pill('idle','gray');
  $('msUptime').textContent=st.uptime_seconds!=null?Math.round(st.uptime_seconds)+'s':'—';
  $('msStt').textContent=st.stt_model||'—';
  $('msTranscript').innerHTML=st.current_transcript?esc(st.current_transcript):'<span class="na">—</span>';
  $('msResponse').innerHTML=st.current_response?esc(st.current_response):'<span class="na">—</span>';

  // ---- LIVE TURN ----
  const rd=st.last_route_decision||{};
  const conf=(rd.confidence!=null)?(+rd.confidence).toFixed(3):null;
  const interrupted=(st.runtime_state==='INTERRUPTING')||(st.cancelled_turn_ids&&st.cancelled_turn_ids.length&&st.cancelled_turn_ids.includes(st.active_turn_id));
  $('turnKv').innerHTML=[
    ['Turn ID', esc((turn&&turn.turn_id) ?? st.active_turn_id ?? '—')],
    ['User transcript', (turn&&(turn.stt_result||turn.mic_capture_text))?esc(turn.stt_result||turn.mic_capture_text):'<span class="na">—</span>'],
    ['Route / domain', rd.domain?pill(rd.domain,rd.domain==='general'?'gray':'blue'):'<span class="na">no route yet</span>'],
    ['Router confidence', conf!=null?(conf+(conf==='0.000'?' '+pill('zero-cue','amber'):'')):na()],
    ['Retrieved units', rd.retrieved_unit_ids?rd.retrieved_unit_ids.length:na()],
    ['Fallback reason', rd.fallback_reason?esc(rd.fallback_reason):'<span class="na">—</span>'],
    ['Memory included', na()+' <span style="font-size:10px;color:var(--gray)">(not in /api/status)</span>'],
    ['Memory rejected/domain', na()],
    ['TTS text', (turn&&turn.tts_text)?esc(turn.tts_text.slice(0,80)):'<span class="na">—</span>'],
    ['Playback', st.playback_active?pill('ACTIVE','blue'):pill('idle','gray')],
    ['Interrupted', interrupted?pill('YES','amber'):pill('no','gray')],
    ['Last error', st.last_error?('<span class="c-red">'+esc(st.last_error)+'</span>'):'<span class="na">none</span>'],
  ].map(([k,v])=>`<div class="k">${k}</div><div class="v">${v}</div>`).join('');

  // ---- CONFIG COVERAGE + DOMAIN CARDS ----
  const covByDom={};(cov&&cov.domains||[]).forEach(c=>covByDom[c.domain]=c);
  const selDom=rd.domain||null;
  const doms=[
    {key:'general',name:'GENERAL',c:null},
    {key:'human',name:'HUMAN CONFIG',c:covByDom.human},
    {key:'music',name:'MUSIC',c:covByDom.music},
    {key:'philos',name:'PHILOS',c:covByDom.philos},
  ];
  const selMap={general:'general',human:'human_config',music:'music_config',philos:'philos'};
  $('domGrid').innerHTML=doms.map(d=>{
    const sel=(selDom===selMap[d.key]);
    const c=d.c;
    let body;
    if(d.key==='general'){
      body=`<div class="m">no master • base model answers</div><div class="m">coverage: ${pill('N/A','gray')}</div>`;
    }else if(c){
      const parts=[`status: ${pill(c.status,covColor(c.status))}`];
      if(c.known!=null)parts.push(`known: <b>${c.known}</b>`);
      if(c.partial!=null&&c.partial>0)parts.push(`open: ${c.partial}`);
      if(c.unmapped!=null&&c.unmapped>0)parts.push(`unmapped: ${c.unmapped}`);
      if(c.total_rows!=null)parts.push(`rows: ${c.total_rows}`);
      body=`<div class="m">${parts.join(' • ')}</div>`;
    }else body=`<div class="m">${na()}</div>`;
    return `<div class="dom ${sel?'sel':''}"><div class="name">${d.name}${sel?' '+pill('SELECTED','blue'):''}</div>${body}</div>`;
  }).join('');

  // config incompleteness warning bar (backend-driven)
  const h=covByDom.human,m=covByDom.music,p=covByDom.philos;
  const warns=[];
  if(h&&h.status!=='COMPLETE')warns.push(`HUMAN CONFIG — ${h.status}`);
  if(m&&m.status!=='COMPLETE')warns.push(`MUSIC CONFIG — ${m.status}`);
  if(warns.length){
    $('covWarnWrap').style.display='';
    $('covWarn').innerHTML='⚠ '+warns.join('  •  ')+'  —  Philos continues to expand from these sources (config coverage is not complete).';
  }else $('covWarnWrap').style.display='none';

  // ---- DAY OPENING ----
  const ds=st.day_opening_state||'IDLE', dc=doColor(ds);
  $('doPill').className='pill '+dc;$('doPill').textContent=ds;
  const planned=(doStat&&doStat.planned_chars!=null)?doStat.planned_chars:null;
  const spoken=(doStat&&doStat.spoken_chars!=null)?doStat.spoken_chars:0;
  const prog=(doStat&&doStat.progress!=null)?Math.min(100,Math.round(doStat.progress*100)):0;
  const barKind=(ds==='COMPLETED')?'green':(ds==='INTERRUPTED'||ds==='ERROR')?'amber':(ds==='PLAYING'?'blue':'gray');
  $('doBar').className='bg-'+barKind;$('doBar').style.width=prog+'%';
  const started=(doStat&&doStat.started_at)?new Date(doStat.started_at*1000).toLocaleTimeString():na();
  const naLive=(txt)=>na()+' <span style="font-size:10px;color:var(--gray)">('+txt+')</span>';
  $('doKv').innerHTML=[
    ['State', pill(ds,dc)],
    ['Turn ID', (doStat&&doStat.turn_id!=null)?doStat.turn_id:naLive('not persisted per-run')],
    ['Current section', (doStat&&doStat.current_section!=null)?doStat.current_section:naLive('not tracked live')],
    ['Section total', (doStat&&doStat.section_total!=null)?doStat.section_total:na()],
    ['Progress', (planned!=null)?`${prog}% (${spoken}/${planned} chars)`:na()],
    ['Fully spoken', (doStat&&doStat.fully_spoken!=null)?(doStat.fully_spoken?pill('YES','green'):pill('NO','amber')):na()],
    ['Interrupted', (doStat&&doStat.interrupted!=null)?(doStat.interrupted?pill('YES','amber'):pill('no','gray')):na()],
    ['Started at', started],
    ['Completed at', (doStat&&doStat.completed_at)?new Date(doStat.completed_at*1000).toLocaleTimeString():na()],
    ['Last error', (doStat&&doStat.last_error)?('<span class="c-red">'+esc(doStat.last_error)+'</span>'):'<span class="na">none</span>'],
  ].map(([k,v])=>`<div class="k">${k}</div><div class="v">${v}</div>`).join('');
  // control-safety for Start
  const doBusy=(ds==='COLLECTING'||ds==='PLAYING');
  $('doStart').disabled=doBusy || st.runtime_state!=='IDLE';
  $('doStart').title=doBusy?'Day Opening already running':(st.runtime_state!=='IDLE'?'runtime must be IDLE':'');
  if(doStat)$('doClap').checked=!!doStat.double_clap_enabled;

  // ---- AUDIO / BARGE HEALTH (honest: barge DEGRADED, AEC PARTIAL) ----
  const a=audio||{};
  $('audioKv').innerHTML=[
    ['Input device', na()],
    ['Output device', na()],
    ['Sample rate', a.sample_rate?(a.sample_rate+' Hz'):na()],
    ['Mic channel', a.selected_mic_channel!=null?('ch '+a.selected_mic_channel):na()],
    ['Command RMS thr', a.vad_threshold!=null?a.vad_threshold.toFixed(5):(a.speech_threshold!=null?a.speech_threshold.toFixed(5):na())],
    ['Selected ch RMS', a.selected_channel_rms!=null?a.selected_channel_rms.toFixed(5):na()],
    ['Playback active', st.playback_active?pill('YES','blue'):pill('no','gray')],
    ['Input muted', st.input_muted?pill('YES','amber'):pill('no','gray')],
    ['Output muted', st.muted?pill('YES','amber'):pill('no','gray')],
    ['Barge-in health', pill('DEGRADED','amber')+' <span style="font-size:10px;color:var(--gray)">(live Day Opening still self-barges)</span>'],
    ['AEC', pill('PARTIAL / EXPERIMENTAL','amber')+' <span style="font-size:10px;color:var(--gray)">(ERLE high but residual self-barge)</span>'],
  ].map(([k,v])=>`<div class="k">${k}</div><div class="v">${v}</div>`).join('');

  // ---- ERROR SURFACE ----
  const errs=[];
  if(st.last_error)errs.push({t:'',src:'runtime',msg:st.last_error});
  if(st.invariant_violations&&st.invariant_violations.length)errs.push({t:'',src:'invariant',msg:st.invariant_violations.join('; ')});
  (ev&&ev.events||[]).filter(e=>/error|ERROR|fail|EXC/i.test((e.event||'')+(e.result||''))).slice(-6).forEach(e=>{
    errs.push({t:e.ts?new Date(e.ts*1000).toLocaleTimeString():'',src:e.component||e.source||'',msg:(e.event||'')+' '+(e.payload_summary||e.result||'')});
  });
  $('errSurface').innerHTML=errs.length
    ? errs.map(e=>`<div style="margin-bottom:4px">${dot('red')}<b>${esc(e.src||'?')}</b> <span style="color:var(--dim)">${esc(e.t)}</span><br><span class="c-red" style="font-size:11px">${esc(e.msg).slice(0,220)}</span></div>`).join('')
    : `${dot('green')}<span style="color:var(--dim)">none recent</span>`;

  // ---- EVENT TIMELINE (filter debug spam) ----
  const IMPORTANT=/WAKE|CAPTURE|STT|ROUTE|MEMORY|TTS_START|PLAYBACK_START|USER_SPEECH_CONFIRMED|PLAYBACK_TERMINATED|TURN|INTERRUPT|DAY_OPENING|ERROR|CANCEL|BARGE-IN|MUTE|RESET/i;
  const SPAM=/BARGE_CHANNEL_RMS|BARGE_CALLBACK|BARGE_MIC_RMS|BARGE_SELECTED_RMS|VAD heartbeat|vad-near|BARGE_CORR/i;
  const rows=(ev&&ev.events||[]).filter(e=>{const t=(e.event||'')+' '+(e.component||'');return IMPORTANT.test(t)&&!SPAM.test(t);}).slice(-40).reverse();
  $('tlBody').innerHTML=rows.map(e=>`<tr>
     <td>${esc(e.ts?new Date(e.ts*1000).toLocaleTimeString():'')}</td>
     <td>${esc(e.turn_id ?? '')}</td>
     <td>${esc(e.component||e.source||'')}</td>
     <td>${esc(e.event||'')}</td>
     <td>${esc((e.result||e.payload_summary||'')).slice(0,60)}</td></tr>`).join('')
     || `<tr><td colspan="5" class="na">no operational events yet</td></tr>`;

  renderControls(st);
}

// ---- CONTROLS (grouped, real endpoints, state-derived safety) ----
function renderControls(st){
  const playing=!!st.playback_active, muted=!!st.muted, inMuted=!!st.input_muted;
  const paused=(st.vad_state==='PAUSED'||st.runtime_state==='PAUSED');
  const g=(lbl,btns)=>`<div class="ctlgrp"><div class="lbl">${lbl}</div>${btns}</div>`;
  const b=(txt,fn,opts={})=>`<button class="${opts.cls||''}" ${opts.dis?'disabled':''} title="${opts.title||''}" onclick="${fn}">${txt}</button>`;
  $('controls').innerHTML=
    g('Voice',
      b('⏹ Stop Speaking','call(\'stop_speaking\')',{cls:'danger',dis:!playing,title:playing?'':'no active playback'})+
      b(muted?'🔊 Unmute Out':'🔇 Mute Out', muted?'call(\'unmute\')':'call(\'mute\')')+
      b(inMuted?'🎙 Unmute In':'🎙🚫 Mute In', inMuted?'call(\'unmute_input\')':'call(\'mute_input\')'))+
    g('Listening',
      b('🎙 Start','call(\'start_listening\')')+b('🛑 Stop','call(\'stop_listening\')')+
      b('⏸ Pause','call(\'pause_listening\')',{dis:paused})+b('▶ Resume','call(\'resume_listening\')',{dis:!paused}))+
    g('Turn',
      b('✂ Cancel Turn','call(\'cancel_turn\')',{dis:st.active_turn_id==null})+
      b('↺ Reset Turn','confirmed(\'reset_turn\',\'Reset turn numbering? Conversation stays intact.\')'))+
    g('Session',
      b('🧹 Clear Conversation','confirmed(\'clear_conversation\',\'Clear conversation history? (does NOT touch knowledge masters)\')')+
      b('⟲ Reset Session','confirmed(\'reset_session\',\'Reset turn state + conversation history?\')'))+
    g('Service',
      b('⟳ Restart Service','confirmed(\'restart_service\',\'Restart Merlin? Old process exits, new starts.\')',{cls:'danger'})+
      b('☠ Emergency Kill','confirmed(\'emergency_kill\',\'Kill the service process now? (launchd KeepAlive may relaunch it)\')',{cls:'danger'}))+
    g('Tools',
      b('🎚 Test Mic 5s','call(\'test_mic?duration_s=5\')')+
      `<select id="chanSel" onchange="setChannel()"><option value="auto">AUTO ch</option>${
        [0,1,2,3,4,5].map(c=>`<option value="${c}" ${st.forced_mic_channel==c?'selected':''}>ch ${c}</option>`).join('')}</select>`);
}

async function call(ep){
  $('ctlNote').textContent='… '+ep;
  try{const r=await fetch('/api/'+ep,{method:'POST'});const d=await r.json().catch(()=>({}));
    $('ctlNote').innerHTML=(r.ok&&d.ok!==false)?`${dot('green')}${ep} ok`:`${dot('red')}${ep}: ${esc(d.error||r.status)}`;}
  catch(e){$('ctlNote').innerHTML=`${dot('red')}${ep}: ${esc(e.message)}`;}
  setTimeout(refresh,400);
}
function confirmed(ep,msg){if(confirm(msg))call(ep);}
async function sendAsUser(){const t=$('sendText').value.trim();if(!t)return;
  await fetch('/api/send_as_user',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t})});
  $('sendText').value='';$('ctlNote').innerHTML=`${dot('green')}sent as user`;setTimeout(refresh,400);}
async function startDayOpening(){$('ctlNote').textContent='starting Day Opening…';
  const r=await fetch('/api/day_opening/start',{method:'POST'});const d=await r.json().catch(()=>({}));
  $('ctlNote').innerHTML=(r.ok)?`${dot('green')}Day Opening started`:`${dot('red')}${esc(d.error||r.status)}`;setTimeout(refresh,500);}
async function toggleClap(){await fetch('/api/day_opening/double_clap',{method:'POST',headers:{'Content-Type':'application/json'},
  body:JSON.stringify({enabled:$('doClap').checked})});setTimeout(refresh,300);}
async function setChannel(){const v=$('chanSel').value;
  await fetch('/api/force_channel',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({channel:v})});setTimeout(refresh,300);}

// AC — full snapshot before live updates, then poll
refresh().then(()=>setInterval(refresh,1500));
</script>
</body>
</html>
