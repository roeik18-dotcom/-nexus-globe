# Voice Gateway — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Adapter selection ──────────────────────────────────────────────────────────
# echo   — zero-latency loopback (for benchmarking)
# claude — single Claude model adapter
# jarvis — Jarvis + Philos delegation (requires ANTHROPIC_API_KEY)
ADAPTER=echo

# Active persona when ADAPTER=jarvis or ADAPTER=claude
PERSONA=jarvis

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for ADAPTER=claude and ADAPTER=jarvis
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for STT_PROVIDER=whisper and TTS_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME

# ── STT / TTS providers ───────────────────────────────────────────────────────
# STT_PROVIDER: whisper | mock
STT_PROVIDER=mock

# TTS_PROVIDER: openai | system | mock
#   system = macOS `say` binary (no API key needed)
TTS_PROVIDER=mock

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765

# ── Essence integration ────────────────────────────────────────────────────────
# Shared secret that must match INTERNAL_ESSENCE_TOKEN in the Next.js environment.
# Leave blank to disable Essence context injection (voice session degrades gracefully).
INTERNAL_ESSENCE_TOKEN=
# Base URL of the Next.js server (used to call the internal Essence route).
ESSENCE_BASE_URL=http://localhost:3000
