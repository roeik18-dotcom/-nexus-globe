# Voice Gateway — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Adapter selection ──────────────────────────────────────────────────────────
# echo   — zero-latency loopback (for benchmarking)
# claude — single Claude model adapter
# jarvis — Jarvis + Philos delegation (requires ANTHROPIC_API_KEY)
ADAPTER=claude

# Active persona when ADAPTER=claude
PERSONA=jarvis

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for ADAPTER=claude
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for STT_PROVIDER=whisper and TTS_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME

# ── STT / TTS providers ───────────────────────────────────────────────────────
# STT_PROVIDER: whisper | mock
#   whisper = OpenAI Whisper (supports Hebrew + English automatically)
STT_PROVIDER=whisper

# TTS_PROVIDER: elevenlabs | openai | system | mock
#   elevenlabs = ElevenLabs (best quality, requires ELEVENLABS_API_KEY)
#   openai     = OpenAI TTS HD (very good, requires OPENAI_API_KEY)
#   system     = macOS `say` (free, no key, robotic — for testing only)
TTS_PROVIDER=openai

# OpenAI TTS voice and model (used when TTS_PROVIDER=openai)
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1-hd

# ── ElevenLabs TTS (best quality — set TTS_PROVIDER=elevenlabs to activate) ──
ELEVENLABS_API_KEY=
# Voice IDs (copy one into ELEVENLABS_VOICE_ID):
#   JBFqnCBsd6RMkjVDRZzb  George  — deep, British, authoritative (default)
#   N2lVS1w4EtoT3dr4eOWO  Callum  — masculine, commanding
#   IKne3meq5aSn9XLyUdCD  Charlie — conversational, warm
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_turbo_v2_5 = fastest + multilingual | eleven_multilingual_v2 = highest quality
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765

# ── Essence integration ────────────────────────────────────────────────────────
# Shared secret that must match INTERNAL_ESSENCE_TOKEN in the Next.js environment.
# Leave blank to disable Essence context injection (voice session degrades gracefully).
INTERNAL_ESSENCE_TOKEN=
# Base URL of the Next.js server (used to call the internal Essence route).
ESSENCE_BASE_URL=http://localhost:3000
