# Nexus-Globe — server-side environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── Internal service authentication ───────────────────────────────────────────
# Shared secret for the internal Essence API route.
# Must match INTERNAL_ESSENCE_TOKEN in voice-gateway/.env.
# Generate with: openssl rand -hex 32
INTERNAL_ESSENCE_TOKEN=

# ── Essence persistence ────────────────────────────────────────────────────────
# Absolute path to the directory where profile JSON files are stored.
# When set, the server uses FileSystemEssenceRepository (data survives restart).
# When unset, an in-memory store is used (data lost on restart — for dev/test only).
# Example: ESSENCE_DATA_DIR=/var/lib/nexus-globe/essence
ESSENCE_DATA_DIR=

# ── PHILOS canon integration (app/api/canon/**) ────────────────────────────────
# Read-side shared secret for GET /api/canon/observations/[id]/orientation.
# Must match PHILOS_CANON_READ_TOKEN in voice-gateway/.env.
# Generate with: openssl rand -hex 32
CANON_READ_TOKEN=
# Ingest-side shared secret for POST /api/canon/observations.
# Must match PHILOS_CANON_INGEST_TOKEN in voice-gateway/.env.
# Generate with: openssl rand -hex 32
CANON_INGEST_TOKEN=
# Directory the canon event log is written to (canon-events.jsonl), a SIBLING
# of .philos-data, never nested inside it. Defaults to .philos-canon-data
# under the process's cwd when unset.
CANON_DATA_DIR=
