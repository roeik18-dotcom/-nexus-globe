# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude preview/dev config
.claude/
__pycache__/
*.log
wake-diag.log

# ── Personal Config: real profile data stays LOCAL ───────────────────────────
# "Private repo" is not the same as "not exposed": history is permanent, a push
# or a shared branch leaks it, and a later .gitignore does not undo a commit.
# Tracked: schema, loader, synthetic *.example.yaml. Never: Roei's own data.
voice-gateway/profiles/*.yaml
!voice-gateway/profiles/*.example.yaml
